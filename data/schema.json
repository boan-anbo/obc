{
  "schema": "openbibliographies.data-schemas.v1",
  "workRecord": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "creators": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "romanized": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "role"
          ],
          "additionalProperties": false
        }
      },
      "year": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "venue": {
        "type": "string"
      },
      "format": {
        "type": "string",
        "enum": [
          "book",
          "article",
          "chapter",
          "review",
          "other"
        ]
      },
      "workType": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "study",
            "survey",
            "reference",
            "translation",
            "edition",
            "source-collection",
            "catalogue",
            "collection"
          ]
        }
      },
      "labels": {
        "type": "object",
        "properties": {
          "discipline": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "region": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "period": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subject": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topic": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keyword": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "discipline",
          "region",
          "period",
          "subject",
          "topic",
          "keyword"
        ],
        "additionalProperties": false
      },
      "isbn": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^97[89]\\d{10}$"
        }
      },
      "doi": {
        "type": "string",
        "pattern": "^10\\.\\d{4,9}\\/[^\\s\"\u003c\u003e]+$"
      },
      "language": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Za-z]{4})?$"
      },
      "titleRomanized": {
        "type": "string",
        "minLength": 1
      },
      "titleEnglish": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "editorial": {
            "type": "boolean"
          }
        },
        "required": [
          "value",
          "editorial"
        ],
        "additionalProperties": false
      },
      "relations": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "hasVersion",
                "isVersionOf"
              ]
            },
            "work": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "required": [
            "type",
            "work"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "title",
      "creators",
      "format",
      "labels"
    ],
    "additionalProperties": false
  },
  "vocabulary": {
